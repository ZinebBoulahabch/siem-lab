# =============================================================
# .gitignore for siem-lab
# Goal: never publish secrets, keys, certificates, firewall backups,
# VM disks or heavy captures. This repository is public.
# Check with `git status` and `git diff --cached` before each commit.
# =============================================================

# --- 1. Passwords and secrets in clear text -------------------
.env
.env.*
*.secret
*.secrets
secrets/
secrets.*
credentials*
passwords*
*password*.txt
*password*.md
*.kdbx
vault*.yml
*.vault
.vault_pass*

# Keep example files that contain no real value
!.env.example
!*.example

# --- 2. SSH keys, TLS keys and certificates -------------------
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.pem
*.key
*.ppk
*.pfx
*.p12
*.jks
*.crt
*.cer
*.csr
*.der
authorized_keys
known_hosts

# --- 3. Firewall, Wazuh and tool configuration with secrets ---
# pfSense configuration backups contain password hashes and keys
config-*.xml
pfsense-config*.xml
# Wazuh installer archive contains the generated admin passwords
wazuh-install-files.tar
wazuh-passwords.txt
client.keys
# Wazuh / MISP / TheHive / Shuffle runtime data and API keys
.wazuh-keys/
misp-api-key*
thehive-api-key*
shuffle-api-key*
*.apikey

# --- 4. VM files and installation media -----------------------
*.vmdk
*.vmx
*.vmxf
*.vmsd
*.vmsn
*.vmem
*.nvram
*.lck/
*.iso
*.ova
*.ovf

# --- 5. Exports, captures and heavy temporary files -----------
*.pcap
*.pcapng
*.cap
*.dmp
*.raw
*.mem
*.sql
*.sql.gz
*.dump
*.bak
*.backup
*.log
*.log.*
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
exports/
tmp/
temp/
*.tmp

# Malware samples and offensive payloads used in the lab
samples/
payloads/
loot/

# Raw log dumps (keep only small, sanitized excerpts in attacks/)
raw-logs/

# --- 6. Operating system and editor files ---------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/

# --- 7. Python / tooling artifacts ----------------------------
__pycache__/
*.pyc
.venv/
venv/
node_modules/
